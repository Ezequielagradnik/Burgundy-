# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Secret key (sb_secret_...) o la service_role legacy. Solo servidor, nunca exponerla.
SUPABASE_SECRET_KEY=

# PIN de 4 dígitos para entrar a la app
APP_PIN=1234
# Texto random de 32+ caracteres. Generar con: openssl rand -base64 32
SESSION_SECRET=

# Audio con IA. Dejar en false hasta habilitar el AI Gateway (necesita tarjeta en Vercel).
# Con false, el texto dictado se interpreta con reglas, sin costo.
AI_ENABLED=false

# Vercel AI Gateway (para el audio). En Vercel se autentica solo con OIDC;
# en local corré `vercel env pull` o poné una key de AI Gateway acá.
AI_GATEWAY_API_KEY=
